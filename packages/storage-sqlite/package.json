{
  "name": "@systemfsoftware/agent-storage-sqlite",
  "version": "0.2.2",
  "description": "Node SQLite persistence adapters for the Effect Agent durable runtime and optional memory lifecycle.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/agent.git",
    "directory": "packages/storage-sqlite"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": [],
  "exports": {
    ".": "./src/index.ts",
    "./sqlite-activity-store": "./src/SqliteActivityStore.ts",
    "./sqlite-schedule-store": "./src/SqliteScheduleStore.ts",
    "./sqlite-storage-config": "./src/SqliteStorageConfig.ts",
    "./sqlite-storage-error": "./src/SqliteStorageError.ts",
    "./sqlite-storage-failpoint": "./src/SqliteStorageFailpoint.ts",
    "./sqlite-storage-version": "./src/SqliteStorageVersion.ts",
    "./sqlite-submission-ledger": "./src/SqliteSubmissionLedger.ts",
    "./sqlite-subscription-store": "./src/SqliteSubscriptionStore.ts",
    "./sqlite-thread-store": "./src/SqliteThreadStore.ts",
    "./sqlite-message-delivery-store": "./src/SqliteMessageDeliveryStore.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./sqlite-activity-store": {
        "types": "./dist/SqliteActivityStore.d.mts",
        "default": "./dist/SqliteActivityStore.mjs"
      },
      "./sqlite-schedule-store": {
        "types": "./dist/SqliteScheduleStore.d.mts",
        "default": "./dist/SqliteScheduleStore.mjs"
      },
      "./sqlite-storage-config": {
        "types": "./dist/SqliteStorageConfig.d.mts",
        "default": "./dist/SqliteStorageConfig.mjs"
      },
      "./sqlite-storage-error": {
        "types": "./dist/SqliteStorageError.d.mts",
        "default": "./dist/SqliteStorageError.mjs"
      },
      "./sqlite-storage-failpoint": {
        "types": "./dist/SqliteStorageFailpoint.d.mts",
        "default": "./dist/SqliteStorageFailpoint.mjs"
      },
      "./sqlite-storage-version": {
        "types": "./dist/SqliteStorageVersion.d.mts",
        "default": "./dist/SqliteStorageVersion.mjs"
      },
      "./sqlite-submission-ledger": {
        "types": "./dist/SqliteSubmissionLedger.d.mts",
        "default": "./dist/SqliteSubmissionLedger.mjs"
      },
      "./sqlite-subscription-store": {
        "types": "./dist/SqliteSubscriptionStore.d.mts",
        "default": "./dist/SqliteSubscriptionStore.mjs"
      },
      "./sqlite-thread-store": {
        "types": "./dist/SqliteThreadStore.d.mts",
        "default": "./dist/SqliteThreadStore.mjs"
      },
      "./sqlite-message-delivery-store": {
        "types": "./dist/SqliteMessageDeliveryStore.d.mts",
        "default": "./dist/SqliteMessageDeliveryStore.mjs"
      }
    },
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b",
    "test": "vitest run --passWithNoTests",
    "check:pack": "pnpm pack --pack-destination .pack && attw .pack/*.tgz --profile esm-only; s=$?; rm -rf .pack; exit $s"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/sql-sqlite-node": "catalog:",
    "@systemfsoftware/agent": "workspace:*",
    "@systemfsoftware/agent-storage-sql": "workspace:*"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@effect/vitest": "catalog:",
    "effect": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "^4.1.0"
  }
}
