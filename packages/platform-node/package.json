{
  "name": "@yielded/agent-platform-node",
  "version": "0.1.0-beta.192",
  "description": "Class DN layer assembly for Effect Agent: the durable Node/SQLite runtime host, wake scheduler, and ownership drain.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yielded-dev/agent.git",
    "directory": "packages/platform-node"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": [],
  "exports": {
    ".": "./src/index.ts",
    "./node-durable-agent-runtime": "./src/NodeDurableAgentRuntime.ts",
    "./node-durable-host": "./src/NodeDurableHost.ts",
    "./node-scheduling": "./src/NodeScheduling.ts",
    "./node-subscriptions": "./src/NodeSubscriptions.ts",
    "./node-wake-scheduler": "./src/NodeWakeScheduler.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./node-durable-agent-runtime": {
        "types": "./dist/NodeDurableAgentRuntime.d.mts",
        "default": "./dist/NodeDurableAgentRuntime.mjs"
      },
      "./node-durable-host": {
        "types": "./dist/NodeDurableHost.d.mts",
        "default": "./dist/NodeDurableHost.mjs"
      },
      "./node-scheduling": {
        "types": "./dist/NodeScheduling.d.mts",
        "default": "./dist/NodeScheduling.mjs"
      },
      "./node-subscriptions": {
        "types": "./dist/NodeSubscriptions.d.mts",
        "default": "./dist/NodeSubscriptions.mjs"
      },
      "./node-wake-scheduler": {
        "types": "./dist/NodeWakeScheduler.d.mts",
        "default": "./dist/NodeWakeScheduler.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "effect-tsgo tsrs --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "check:pack": "pnpm pack --pack-destination .pack && attw .pack/*.tgz --profile esm-only; s=$?; rm -rf .pack; exit $s"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/sql-sqlite-node": "catalog:",
    "@yielded/agent": "workspace:*",
    "@yielded/agent-storage-sqlite": "workspace:*"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@effect/vitest": "catalog:",
    "effect": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "^4.1.4"
  }
}
