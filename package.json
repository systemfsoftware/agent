{
  "name": "agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.0",
  "engines": {
    "node": "^26.0.0"
  },
  "scripts": {
    "prepare": "effect-tsgo patch --oxlint --no-typescript",
    "build": "pnpm -r run build && pnpm run action:build",
    "typecheck": "effect-tsgo tsc -b",
    "lint": "pnpm --filter @systemfsoftware/agent-docs exec astro sync >/dev/null && effect-tsgo oxlint . --type-aware --format=${OXLINT_FORMAT:-default}",
    "test": "pnpm -r run test",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "check:exports": "node scripts/verify-package-exports.ts",
    "check:record-format": "esbuild scripts/verify-record-format.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=scripts/.verify-record-format.mjs && node scripts/.verify-record-format.mjs",
    "check:package-purity": "node scripts/verify-package-purity.ts",
    "check:pack": "pnpm -r --filter './packages/*' run check:pack",
    "action:build": "node scripts/build-action.ts",
    "ready": "dprint check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "check:gritlint": "nix run .#gritlint -- check ."
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "catalog:",
    "@systemfsoftware/oxlint-config-recommended": "^8.0.3",
    "@types/node": "catalog:",
    "@systemfsoftware/agent": "workspace:*",
    "@systemfsoftware/agent-storage-sql": "workspace:*",
    "dprint": "catalog:",
    "effect": "catalog:",
    "esbuild": "catalog:",
    "oxlint": "~1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "tsrs": "catalog:",
    "typescript": "catalog:",
    "typescript-twoslash": "catalog:",
    "vitest": "catalog:"
  }
}
