{
  "name": "@systemfsoftware/agent-example-cloudflare-memory",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "measure": "esbuild src/measure-main.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=.scripts/measure-main.mjs && node .scripts/measure-main.mjs",
    "measure:heap": "esbuild src/heap-main.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=.scripts/heap-main.mjs && node .scripts/heap-main.mjs",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@systemfsoftware/agent": "workspace:*",
    "@systemfsoftware/agent-platform-cloudflare": "workspace:*",
    "@systemfsoftware/agent-storage-cloudflare": "workspace:*",
    "effect": "catalog:",
    "effect-cf": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "miniflare": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "wrangler": "catalog:"
  }
}
